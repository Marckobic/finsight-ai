# Production environment for the Expo web build.
#
# IMPORTANT: EXPO_PUBLIC_* values are inlined at BUILD time. Editing this file
# does not change a deployed app. Set EXPO_PUBLIC_API_URL in the Vercel project
# settings (Settings → Environment Variables) and redeploy.
#
# There is no localhost fallback in production builds — a missing value throws
# at startup instead of shipping an app that quietly points at a laptop.

EXPO_PUBLIC_API_URL=https://REPLACE-WITH-YOUR-RAILWAY-URL.up.railway.app

# Optional: activates PostHog in lib/analytics.ts
# EXPO_PUBLIC_POSTHOG_KEY=
