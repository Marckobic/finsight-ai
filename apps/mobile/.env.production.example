# Production environment for the Expo web build.
#
# IMPORTANT: EXPO_PUBLIC_* values are inlined at BUILD time by `expo export`,
# which runs on YOUR machine — Vercel only serves the resulting dist/. A
# variable set in the Vercel dashboard therefore does nothing. Copy this file
# to .env, put the real URL in, then rebuild and redeploy:
#
#   cd apps/mobile
#   npx expo export --platform web --clear
#   vercel --prod
#
# There is no localhost fallback in production builds — a missing value throws
# at startup instead of shipping an app that quietly points at a laptop.

EXPO_PUBLIC_API_URL=https://REPLACE-WITH-YOUR-RAILWAY-URL.up.railway.app

# Optional: activates PostHog in lib/analytics.ts
# EXPO_PUBLIC_POSTHOG_KEY=
